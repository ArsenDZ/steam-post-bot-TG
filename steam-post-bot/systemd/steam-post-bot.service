[Unit]
Description=Steam Post Editor Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Замените на своего пользователя и реальный путь к проекту на сервере
User=YOUR_LINUX_USER
WorkingDirectory=/home/YOUR_LINUX_USER/steam-post-bot
ExecStart=/home/YOUR_LINUX_USER/steam-post-bot/venv/bin/python main.py
Restart=on-failure
RestartSec=15
Environment=PYTHONUNBUFFERED=1

StartLimitIntervalSec=300
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
